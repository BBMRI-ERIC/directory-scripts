{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed Directory vocabulary guidance",
  "type": "object",
  "required": [
    "schema_version",
    "sources",
    "production_checks",
    "expectations",
    "manual_sections",
    "migrations",
    "miabis_bindings",
    "structural_changes"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "production_checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "target",
          "schema",
          "checked_at",
          "server_manifest",
          "content_hashes",
          "compatible_source_ids",
          "note"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "checked_at": {
            "type": "string",
            "minLength": 1
          },
          "server_manifest": {
            "type": "object"
          },
          "content_hashes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "compatible_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "expectations": {
      "type": "object",
      "required": [],
      "properties": {
        "software": {
          "type": "object",
          "required": [
            "release"
          ],
          "properties": {
            "release": {
              "type": "string",
              "minLength": 1
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "model": {
          "$ref": "#/$defs/component"
        },
        "ontologies": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/component"
          }
        }
      },
      "additionalProperties": false
    },
    "manual_sections": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "title",
          "publication"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publication": {
            "enum": [
              "published",
              "unpublished"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/migration"
      }
    },
    "miabis_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "structural_changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/structural"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "review": {
      "type": "object",
      "required": [
        "state",
        "reviewed_on",
        "note"
      ],
      "properties": {
        "state": {
          "enum": [
            "accepted",
            "needs_review"
          ]
        },
        "reviewed_on": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "repository",
        "revision",
        "path",
        "sha256",
        "locator"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "semantic_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "semantic_hash_basis": {
          "type": "string",
          "minLength": 1
        },
        "term_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "enum": [
            "replace_known_value",
            "inspect_existing_information",
            "ask_curator",
            "collect_missing_metadata",
            "no_safe_replacement"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "required": [
        "terms",
        "relationship",
        "basis",
        "conditions",
        "explanation",
        "evidence_ids"
      ],
      "properties": {
        "terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "relationship": {
          "enum": [
            "equivalent",
            "target_broader",
            "target_narrower",
            "split",
            "combination",
            "unresolved"
          ]
        },
        "basis": {
          "enum": [
            "upstream_explicit",
            "reviewed_recommendation"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "migration": {
      "type": "object",
      "required": [
        "id",
        "explanation",
        "evidence_ids",
        "review",
        "manual_section_ids",
        "table",
        "entity_fields",
        "previous_terms",
        "applicability",
        "history",
        "status",
        "replacement_options",
        "actions",
        "information_needed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "manual_section_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "table": {
          "enum": [
            "DataCategories",
            "ServiceTypes"
          ]
        },
        "entity_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "previous_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "applicability": {
          "type": "object",
          "required": [
            "reviewed_reference_ids"
          ],
          "properties": {
            "reviewed_reference_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "history": {
          "type": "object",
          "required": [
            "before_source_ids",
            "after_source_ids",
            "production_check_ids"
          ],
          "properties": {
            "before_source_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "after_source_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "production_check_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "deprecated",
            "removed",
            "replaced",
            "restored",
            "changed_definition"
          ]
        },
        "replacement_options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "information_needed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": [
        "id",
        "explanation",
        "evidence_ids",
        "review",
        "manual_section_ids",
        "miabis_concept",
        "directory_terms",
        "relationship"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "manual_section_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "miabis_concept": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "source_id",
                "name",
                "locator",
                "definition_hash"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "definition_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "directory_terms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "table",
              "name"
            ],
            "properties": {
              "table": {
                "enum": [
                  "DataCategories",
                  "ServiceTypes"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "relationship": {
          "enum": [
            "equivalent",
            "directory_broader",
            "directory_narrower",
            "missing_in_directory",
            "directory_extension",
            "unresolved"
          ]
        }
      },
      "additionalProperties": false
    },
    "structural": {
      "type": "object",
      "required": [
        "id",
        "explanation",
        "evidence_ids",
        "review",
        "manual_section_ids",
        "before_source_ids",
        "after_source_ids",
        "production_check_ids",
        "affected_fields",
        "change",
        "actions",
        "information_needed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "manual_section_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "before_source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "after_source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "production_check_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "affected_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "change": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "information_needed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "expected_reference_id",
        "older_reference_ids",
        "newer_reference_ids"
      ],
      "properties": {
        "expected_reference_id": {
          "type": "string",
          "minLength": 1
        },
        "older_reference_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "newer_reference_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
