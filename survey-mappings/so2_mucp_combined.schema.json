{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SO2 and MuCP evidence-preserving combined analysis",
    "type": "object",
    "required": [
        "payload_type",
        "payload_version",
        "metadata",
        "inputs",
        "matching_summary",
        "question_catalogues",
        "source_manifest",
        "biobanks",
        "unmatched_so2",
        "unmatched_mucp",
        "manual_review_matches",
        "descriptive_statistics",
        "coverage_audit"
    ],
    "properties": {
        "payload_type": {
            "const": "so2_mucp_combined_analysis"
        },
        "payload_version": {
            "enum": [
                "1",
                "2"
            ]
        },
        "metadata": {
            "type": "object",
            "required": [
                "analytical_unit"
            ],
            "properties": {
                "analytical_unit": {
                    "enum": [
                        "unique_overlapping_biobank",
                        "unique_selected_biobank",
                        "source_reporting_unit"
                    ]
                },
                "cohort": {
                    "type": "object",
                    "required": [
                        "join",
                        "selected_ids",
                        "so2_ids",
                        "mucp_ids",
                        "intersection_ids"
                    ],
                    "properties": {
                        "join": {
                            "enum": [
                                "inner",
                                "all-MuCP",
                                "all-SO2",
                                "outer"
                            ]
                        },
                        "selected_ids": {
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                                "type": "string"
                            }
                        },
                        "so2_ids": {
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                                "type": "string"
                            }
                        },
                        "mucp_ids": {
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                                "type": "string"
                            }
                        },
                        "intersection_ids": {
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "biobanks": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "biobank_id",
                    "name",
                    "country",
                    "identity_resolutions",
                    "so2_source_records",
                    "mucp_source_records",
                    "scopes",
                    "evidence",
                    "observations"
                ],
                "properties": {
                    "biobank_id": {
                        "type": "string",
                        "pattern": "^(bbmri-eric:ID:|mucp-source:)"
                    },
                    "directory_biobank_id": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "reporting_unit_kind": {
                        "enum": [
                            "resolved_biobank",
                            "unresolved_source_reporting_unit",
                            "national_summary"
                        ]
                    },
                    "evidence": {
                        "type": "array",
                        "items": {
                            "$ref": "#/$defs/evidence"
                        }
                    }
                }
            }
        },
        "question_catalogues": {
            "type": "object",
            "required": [
                "SO2",
                "MuCP"
            ]
        },
        "inputs": {
            "type": "object"
        },
        "matching_summary": {
            "type": "object"
        },
        "matching_breakdown": {
            "$ref": "#/$defs/matching_breakdown"
        },
        "source_manifest": {
            "type": "array"
        },
        "unmatched_so2": {
            "type": "array"
        },
        "unmatched_mucp": {
            "type": "array"
        },
        "manual_review_matches": {
            "type": "array"
        },
        "descriptive_statistics": {
            "type": "object",
            "properties": {
                "MuCP": {
                    "type": "object",
                    "properties": {
                        "modality_quantities": {
                            "$ref": "#/$defs/modality_quantities"
                        },
                        "quantity_aggregates": {
                            "$ref": "#/$defs/quantity_aggregates"
                        }
                    }
                }
            }
        },
        "coverage_audit": {
            "type": "object"
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "payload_version": {
                        "const": "2"
                    }
                }
            },
            "then": {
                "properties": {
                    "metadata": {
                        "required": [
                            "cohort"
                        ],
                        "properties": {
                            "analytical_unit": {
                                "enum": ["unique_selected_biobank", "source_reporting_unit"]
                            }
                        }
                    },
                    "biobanks": {
                        "items": {
                            "required": [
                                "survey_participation"
                            ],
                            "properties": {
                                "survey_participation": {
                                    "type": "object",
                                    "required": [
                                        "SO2",
                                        "MuCP"
                                    ],
                                    "additionalProperties": false,
                                    "properties": {
                                        "SO2": {
                                            "type": "boolean"
                                        },
                                        "MuCP": {
                                            "type": "boolean"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    ],
    "$defs": {
        "matching_breakdown": {
            "type": "object",
            "required": [
                "version",
                "surveys",
                "accepted_overlap"
            ],
            "properties": {
                "version": {
                    "const": 1
                },
                "accepted_overlap": {
                    "type": "object",
                    "required": [
                        "count",
                        "directory_ids"
                    ],
                    "properties": {
                        "count": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "directory_ids": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "surveys": {
                    "type": "object",
                    "required": [
                        "SO2",
                        "MuCP"
                    ],
                    "properties": {
                        "SO2": {
                            "$ref": "#/$defs/matching_survey"
                        },
                        "MuCP": {
                            "$ref": "#/$defs/matching_survey"
                        }
                    }
                }
            }
        },
        "matching_survey": {
            "type": "object",
            "required": [
                "total_records",
                "status_counts",
                "distinct_accepted_directory_ids",
                "accepted_directory_ids",
                "accepted_exclusive_directory_ids",
                "accepted_exclusive_directory_id_count",
                "country_groups",
                "country_summary_records"
            ],
            "properties": {
                "total_records": {
                    "type": "integer",
                    "minimum": 0
                },
                "status_counts": {
                    "type": "object",
                    "required": [
                        "accepted",
                        "unmatched",
                        "review",
                        "excluded"
                    ],
                    "properties": {
                        "accepted": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "unmatched": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "review": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "excluded": {
                            "type": "integer",
                            "minimum": 0
                        }
                    }
                },
                "distinct_accepted_directory_ids": {
                    "type": "integer",
                    "minimum": 0
                },
                "accepted_directory_ids": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^bbmri-eric:ID:"
                    }
                },
                "accepted_exclusive_directory_ids": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^bbmri-eric:ID:"
                    }
                },
                "accepted_exclusive_directory_id_count": {
                    "type": "integer",
                    "minimum": 0
                },
                "country_groups": {
                    "type": "object",
                    "required": [
                        "accepted",
                        "unmatched",
                        "review",
                        "excluded"
                    ],
                    "properties": {
                        "accepted": {
                            "$ref": "#/$defs/matching_country_groups"
                        },
                        "unmatched": {
                            "$ref": "#/$defs/matching_country_groups"
                        },
                        "review": {
                            "$ref": "#/$defs/matching_country_groups"
                        },
                        "excluded": {
                            "$ref": "#/$defs/matching_country_groups"
                        }
                    }
                },
                "country_summary_records": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "record_id",
                            "country",
                            "status",
                            "reason"
                        ],
                        "properties": {
                            "record_id": {
                                "type": "string"
                            },
                            "country": {
                                "type": "string"
                            },
                            "status": {
                                "enum": [
                                    "accepted",
                                    "unmatched",
                                    "review",
                                    "excluded"
                                ]
                            },
                            "reason": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "matching_country_groups": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "country",
                    "record_count",
                    "institutions"
                ],
                "properties": {
                    "country": {
                        "type": "string"
                    },
                    "record_count": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "institutions": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "name",
                                "source_names",
                                "record_count",
                                "source_record_ids",
                                "distinct_directory_ids",
                                "directory_ids",
                                "exclusion_reasons"
                            ],
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "source_names": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "record_count": {
                                    "type": "integer",
                                    "minimum": 0
                                },
                                "source_record_ids": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "distinct_directory_ids": {
                                    "type": [
                                        "integer",
                                        "null"
                                    ],
                                    "minimum": 0
                                },
                                "directory_ids": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "exclusion_reasons": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "modality_quantities": {
            "type": "object",
            "required": [
                "observations",
                "coverage",
                "unlinked_quantities",
                "interpretation"
            ],
            "properties": {
                "observations": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "quantity_id",
                            "biobank_id",
                            "country",
                            "source_record_id",
                            "question_id",
                            "scope_id",
                            "collection_id",
                            "value",
                            "unit",
                            "relation",
                            "temporal_status",
                            "linkage",
                            "linkage_basis",
                            "quantity_evidence_id",
                            "quantity_locator",
                            "original_wording",
                            "source_refs",
                            "unit_proof",
                            "modality_links"
                        ],
                        "properties": {
                            "value": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "unit": {
                                "enum": [
                                    "samples",
                                    "donors",
                                    "individuals",
                                    "participants"
                                ]
                            },
                            "linkage": {
                                "enum": [
                                    "modality_specific",
                                    "collection_size_context",
                                    "submission_size_context"
                                ]
                            },
                            "modality_links": {
                                "type": "array",
                                "minItems": 1
                            }
                        }
                    }
                },
                "coverage": {
                    "type": "object",
                    "required": [
                        "cohort_N",
                        "by_modality"
                    ]
                },
                "unlinked_quantities": {
                    "type": "array"
                },
                "interpretation": {
                    "type": "object"
                }
            },
            "additionalProperties": false
        },
        "quantity_aggregates": {
            "type": "object",
            "required": [
                "version",
                "unit_policy",
                "contributions",
                "modality_totals",
                "country_totals",
                "excluded_contributions",
                "diagnostics"
            ],
            "properties": {
                "version": {
                    "const": 1
                },
                "unit_policy": {
                    "type": "object"
                },
                "contributions": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "contribution_id",
                            "biobank_id",
                            "country",
                            "scope_id",
                            "scope_identity",
                            "source_record_id",
                            "basis",
                            "unit",
                            "source_unit",
                            "source_units",
                            "value",
                            "relation",
                            "temporal_status",
                            "modality_ids",
                            "quantity_ids",
                            "quantity_evidence_ids",
                            "source_refs"
                        ],
                        "properties": {
                            "unit": {
                                "enum": [
                                    "donors",
                                    "samples",
                                    "aliquots"
                                ]
                            },
                            "basis": {
                                "enum": [
                                    "collection",
                                    "submission_fallback",
                                    "direct_modality"
                                ]
                            },
                            "value": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "source_refs": {
                                "type": "array",
                                "items": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "modality_totals": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/modality_quantity_total"
                    }
                },
                "country_totals": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/country_quantity_total"
                    }
                },
                "excluded_contributions": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "contribution_id",
                            "biobank_id",
                            "country",
                            "scope_id",
                            "scope_identity",
                            "source_record_id",
                            "basis",
                            "unit",
                            "source_unit",
                            "value",
                            "relation",
                            "temporal_status",
                            "modality_ids",
                            "quantity_ids",
                            "quantity_evidence_ids",
                            "source_refs",
                            "reason"
                        ]
                    }
                },
                "diagnostics": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "code"
                        ]
                    }
                }
            },
            "additionalProperties": false
        },
        "quantity_segment": {
            "type": "object",
            "required": [
                "biobank_id",
                "value",
                "quantity_ids"
            ],
            "properties": {
                "biobank_id": {
                    "type": "string",
                    "minLength": 1
                },
                "value": {
                    "type": "integer",
                    "minimum": 0
                },
                "quantity_ids": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            },
            "additionalProperties": false
        },
        "quantity_total_fields": {
            "type": "object",
            "required": [
                "unit",
                "basis",
                "temporal_status",
                "reported_total",
                "contributing_biobanks",
                "contributing_scopes",
                "excluded_count",
                "segments"
            ],
            "properties": {
                "unit": {
                    "enum": [
                        "donors",
                        "samples",
                        "aliquots",
                        "unit_unclear"
                    ]
                },
                "basis": {
                    "enum": [
                        "collection",
                        "submission_fallback",
                        "direct_modality"
                    ]
                },
                "temporal_status": {
                    "type": "string",
                    "minLength": 1
                },
                "reported_total": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 0
                },
                "contributing_biobanks": {
                    "type": "integer",
                    "minimum": 0
                },
                "contributing_scopes": {
                    "type": "integer",
                    "minimum": 0
                },
                "excluded_count": {
                    "type": "integer",
                    "minimum": 0
                },
                "segments": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/quantity_segment"
                    }
                }
            }
        },
        "modality_quantity_total": {
            "allOf": [
                {
                    "$ref": "#/$defs/quantity_total_fields"
                },
                {
                    "type": "object",
                    "required": [
                        "modality_id"
                    ],
                    "properties": {
                        "modality_id": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                }
            ]
        },
        "country_quantity_total": {
            "allOf": [
                {
                    "$ref": "#/$defs/quantity_total_fields"
                },
                {
                    "type": "object",
                    "required": [
                        "country"
                    ],
                    "properties": {
                        "country": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                }
            ]
        },
        "evidence": {
            "type": "object",
            "required": [
                "evidence_id",
                "survey",
                "source_record_id",
                "question_id",
                "question_label",
                "scope_id",
                "source_refs"
            ],
            "properties": {
                "survey": {
                    "enum": [
                        "SO2",
                        "MuCP"
                    ]
                },
                "evidence_id": {
                    "type": "string",
                    "minLength": 1
                },
                "source_record_id": {
                    "type": "string",
                    "minLength": 1
                },
                "question_id": {
                    "type": "string",
                    "minLength": 1
                },
                "question_label": {
                    "type": "string",
                    "minLength": 1
                },
                "scope_id": {
                    "type": "string",
                    "minLength": 1
                },
                "source_refs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "required": [
                            "locator"
                        ],
                        "properties": {
                            "locator": {
                                "type": "string",
                                "minLength": 1
                            },
                            "path": {
                                "type": "string",
                                "minLength": 1
                            },
                            "source_id": {
                                "type": "string",
                                "minLength": 1
                            }
                        },
                        "anyOf": [
                            {
                                "required": [
                                    "path"
                                ]
                            },
                            {
                                "required": [
                                    "source_id"
                                ]
                            }
                        ]
                    }
                }
            }
        }
    }
}
